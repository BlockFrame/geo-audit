# Provider selection: openai | openrouter | azure | azure_foundry | vertex
LLM_PROVIDER=openai

# Frontend origins allowed by backend CORS.
# For production, set this to your Vercel domain and any custom domain.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional regex for preview deployments, for example: https://.*\.vercel\.app
FRONTEND_ORIGIN_REGEX=

# --- OpenAI (default) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# --- OpenRouter (free-friendly via :free models) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Official free router model from OpenRouter docs
OPENROUTER_MODEL=openrouter/free
# Keep true to enforce free-only behavior in case OPENROUTER_MODEL is changed
OPENROUTER_REQUIRE_FREE=true
# Optional fallback pool used only when OPENROUTER_MODEL != openrouter/free
OPENROUTER_FREE_MODELS=meta-llama/llama-3.3-8b-instruct:free,google/gemma-2-9b-it:free,mistralai/mistral-7b-instruct:free
# Optional headers recommended by OpenRouter
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=GEO-AUDIT-APP

# --- Azure AI Foundry / Azure OpenAI compatible endpoint ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Google Vertex AI Model Garden ---
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-1.5-flash-002
