# Frontend environment variables for GEO Audit Agent

# CopilotKit runtime endpoint (usually same origin)
NEXT_PUBLIC_COPILOTKIT_RUNTIME_URL=/api/copilotkit

# Optional: Explicit Vercel Analytics ID
# (usually auto-detected by Vercel platform)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your_analytics_id

# Backend API configuration
# Use explicit 127.0.0.1 on Windows to avoid localhost issues
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# Public links used in the UI
NEXT_PUBLIC_GITHUB_URL=https://github.com/BlockFrame/geo-audit
NEXT_PUBLIC_DISCORD_URL=https://discord.com
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/rossi-stefano/
NEXT_PUBLIC_FEEDBACK_FORM_URL=https://github.com/geo-audit/issues/new

# Vercel deployment environment
# (auto-set by Vercel, but useful for local development)
NEXT_PUBLIC_VERCEL_ENV=development
